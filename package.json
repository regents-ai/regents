{
  "name": "ash-platform-assets",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "mix assets.build",
    "typecheck": "tsc --project assets/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "npm run assets:build && playwright test",
    "test:budgets": "vitest run --config vitest.budgets.config.ts",
    "test:showcase": "playwright test --config playwright.showcase.config.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.34.0",
    "@solana-program/system": "0.12.2",
    "@solana-program/token": "0.14.0",
    "@solana/kit": "6.10.0",
    "animejs": "4.5.0",
    "heerich": "0.16.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vgpu": "0.3.1",
    "viem": "2.55.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@webgpu/types": "0.1.69",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "ws@^8.0.0": "8.21.0",
    "axios": "1.18.0",
    "decode-uri-component": "0.5.0",
    "uuid": "11.1.1"
  }
