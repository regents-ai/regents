*
!ash-platform/
!ash-platform/assets/**
!ash-platform/config/**
!ash-platform/contracts/**
!ash-platform/deps/**
!ash-platform/lib/**
!ash-platform/priv/**
!ash-platform/rel/**
!ash-platform/mix.exs
!ash-platform/mix.lock
!ash-platform/package.json
!ash-platform/package-lock.json
!elixir-utils/
!elixir-utils/privy/**
!mix-cache/**
!npm-cache/**
!rustler-precompiled/**
!esbuild-linux-arm64

# Dependencies enter as source only. Host-compiled native output would be
# treated as current by mix and shipped for the wrong architecture.
ash-platform/deps/**/*.so
ash-platform/deps/**/*.dylib
ash-platform/deps/**/*.o
ash-platform/deps/**/*.a

# The copied source trees must never carry runtime environment files.
**/.env
**/.env.*
