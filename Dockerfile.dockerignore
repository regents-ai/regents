*
!ash-platform/assets/**
!ash-platform/config/**
!ash-platform/contracts/**
!ash-platform/deps/**
!ash-platform/lib/**
!ash-platform/priv/**
!ash-platform/rel/**
!ash-platform/mix.exs
!ash-platform/mix.lock
!ash-platform/package.json
!ash-platform/package-lock.json
!design-system/regent_ui/**
!elixir-utils/privy/**
!mix-cache/**
!npm-cache/**
!rustler-precompiled/**
!esbuild-linux-arm64
!esbuild-linux-x64

# Notebook output is generated on a developer machine and is not source.
ash-platform/priv/static/notebooks/**

# Dependencies enter as source. A dependency's priv carries compiler output,
# including extensionless host binaries. Two subtrees under it are shipped
# source rather than output: priv/static holds the JavaScript clients the
# asset build resolves through package main entries, and priv/templates is
# where Phoenix copies its generator templates during its own compile.
ash-platform/deps/**/priv/**
!ash-platform/deps/**/priv/static/**
!ash-platform/deps/**/priv/templates/**

# The copied source trees must never carry runtime environment files.
**/.env
**/.env.*
**/.envrc
