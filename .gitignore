# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
ash_platform-*.tar

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# In case you use Node.js/npm, you want to ignore these.
npm-debug.log
/node_modules/
/assets/node_modules/

# Local environment values are loaded by direnv and must never be committed.
.env*
!.env.example

# Repo-local orchestration and agent state belongs to the umbrella workspace or workstation.
/.beads/
/metaprogramming/
/.agents/
/.codex/
/.claude/
/.cursor/
/.idea/
/.vscode/
/CONTEXT.md
/HANDOFF.md

# Local binaries, operating-system files, credentials, certificates, and database copies.
/esbuild-*
.DS_Store
Thumbs.db
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.dump
*.dump.gz
*.sql.gz
*.sqlite
*.sqlite3
*.db
*.db-*

# Playwright writes local run evidence here.
/test-results/
/playwright-report/

# Generated by mix regent_ui.assets from the resolved package.
/assets/vendor/regent_ui/

# Generated from the pinned Regent UI package.
/priv/static/images/regent-ui/
