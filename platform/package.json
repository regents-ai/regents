    "@solana-program/token": "0.17.0",
    "@solana/kit": "8.5.0",
    "@vgpu/wgsl": "0.6.0",
    "animejs": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vgpu": "0.6.0",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.74",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "ws@^8.0.0": "8.22.0",
