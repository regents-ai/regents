{
  "tools": [
    {
      "name": "regents_about",
      "title": "Read about Regents",
      "description": "Read the Regents Labs About page or the developer documentation as Markdown, exactly as regents.sh/about and regents.sh/docs serve it. page chooses which one: about says what Regents Labs does and how it differs, who uses it, the team, key facts and common questions; docs covers the public reads, signed-in reads, agent pairing and these browser tools.",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string",
            "enum": [
              "about",
              "docs"
            ],
            "description": "about for the About page, docs for the developer documentation."
          }
        },
        "required": [
          "page"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false
      },
      "requires": "none",
      "state_changing": false,
      "payment": "none",
      "route": "GET /about, GET /docs",
      "scope": "site",
      "authentication": "public",
      "availability": "available",
      "pairing_required": false,
      "effect": "read",
      "interfaces": {
        "webmcp": "regents_about",
        "http": "GET /about, GET /docs"
      }
    },
    {
      "name": "regents_products",
      "title": "List Regents products",
      "description": "List the products in the Regents family, in the order the site lists them: Autolaunch, Techtree, Patchbay and Keyfleet. Each gives its slug, name, summary, website, source on GitHub and its page on regents.sh. The same copy the /autolaunch, /techtree and /patchbay pages show; read one in full with regents_product.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false
      },
      "requires": "none",
      "state_changing": false,
      "payment": "none",
      "route": "GET /api/v1/products",
      "scope": "site",
      "authentication": "public",
      "availability": "available",
      "pairing_required": false,
      "effect": "read",
      "interfaces": {
        "webmcp": "regents_products",
        "http": "GET /api/v1/products"
      }
    },
    {
      "name": "regents_product",
      "title": "Read a product",
      "description": "Read everything one product's page on regents.sh shows: its heading, summary, what it does, who it is for, its place in the Regents family, a line to give an agent and where to start. Autolaunch also gives its two launch kinds with their figures, why its auction is fair and what to know before bidding.",
      "input_schema": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "autolaunch",
              "techtree",
              "patchbay",
              "keyfleet"
            ]
          }
        },
        "required": [
          "slug"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false
      },
      "requires": "none",
      "state_changing": false,
      "payment": "none",
      "route": "GET /api/v1/products/{slug}",
      "scope": "site",
      "authentication": "public",
      "availability": "available",
      "pairing_required": false,
      "effect": "read",
      "interfaces": {
        "webmcp": "regents_product",
        "http": "GET /api/v1/products/{slug}"
      }
    },
