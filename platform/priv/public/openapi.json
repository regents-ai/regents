{
  "openapi": "3.1.0",
  "info": {
    "title": "Regents public API",
    "version": "2.0.0",
    "description": "Public service health, the product directory, owner-authorized historical name and stake reads, and agent pairing: an agent signs with its own SIWA key to pair with a person's account and to check in. Does not describe wallet transactions, session changes, or separate product APIs.",
    "contact": {
      "name": "Regents Labs"
    }
  },
  "security": [],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getServiceHealth",
        "summary": "Read web-service health",
        "description": "Returns ok when the web service is responding. Does not establish readiness of every external service or wallet flow.",
        "responses": {
          "200": {
            "description": "Web service is responding",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "const": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List the Regents products",
        "description": "Autolaunch, Techtree and Patchbay, in the order the site lists them, with the summary and links their pages on Regents show. Takes no query parameters.",
        "responses": {
          "200": {
            "description": "The product directory",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductList"
                }
              }
            }
          },
          "400": {
            "description": "A query parameter was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products/{slug}": {
      "get": {
        "operationId": "getProduct",
        "summary": "Read one product",
        "description": "Everything the product's page on Regents shows.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "autolaunch",
                "techtree",
                "patchbay"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductEnvelope"
                }
              }
            }
          },
          "400": {
            "description": "A query parameter was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductError"
                }
              }
            }
          },
          "404": {
            "description": "No product has this slug",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/claims": {
      "get": {
        "operationId": "listMyHistoricalNameClaims",
        "summary": "Read historical name claims for the verified account",
        "description": "Read-only recorded name and transaction evidence. Both Privy credentials are required. Never accepts a chosen owner as authority. Responses use Cache-Control: no-store. Does not mint, transfer, or grant entitlements.",
        "security": [
          {
            "PrivyAccessToken": [],
            "PrivyIdentityToken": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "required": false,
            "description": "The exact next cursor from the previous response, at most 2048 UTF-8 bytes. This is the only supported query parameter.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          {
            "name": "X-Privy-User-Id",
            "in": "header",
            "required": false,
            "description": "If supplied, must exactly match the verified account subject. It does not select another owner.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized historical records; next is null at the end",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimsPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimsError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimsError"
                }
              }
            }
          },
          "403": {
            "description": "Account is not authorized for this read",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimsError"
                }
              }
            }
          },
          "503": {
            "description": "Claims service unavailable or unconfigured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimsError"
                }
              }
            }
          },
          "default": {
            "description": "Other HTTP error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/staking/position": {
      "get": {
        "operationId": "getMyStakingPosition",
        "summary": "Read what Stake shows for the verified sign-in's wallet",
        "description": "The shared contract reading beside a fresh reading of the wallet on the verified sign-in. Both Privy credentials are required; the wallet is never chosen by the caller. Responses use Cache-Control: no-store. Never opens a wallet or prepares a transaction.",
        "security": [
          {
            "PrivyAccessToken": [],
            "PrivyIdentityToken": []
          }
        ],
        "parameters": [
          {
            "name": "X-Privy-User-Id",
            "in": "header",
            "required": false,
            "description": "If supplied, must exactly match the verified account subject.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The position",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StakingPosition"
                }
              }
            }
          },
          "400": {
            "description": "A query parameter was sent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StakingError"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StakingError"
                }
              }
            }
          },
          "409": {
            "description": "The sign-in has no wallet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StakingError"
                }
              }
            }
          },
          "503": {
            "description": "Base has not answered yet, or sign-in checks are not set up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StakingError"
                }
              }
            }
          }
        }
      }
    },
    "/api/agents/v1/pair": {
      "post": {
        "operationId": "pairAgent",
        "summary": "Pair this agent with a person's account",
        "description": "Joins the signing agent to the Regents account that issued the one-time pairing code. Sign the request with your SIWA key for the audience regents. A code works once and expires ten minutes after it was made.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/SiwaReceipt"
          },
          {
            "$ref": "#/components/parameters/SiwaKeyId"
          },
          {
            "$ref": "#/components/parameters/SiwaTimestamp"
          },
          {
            "$ref": "#/components/parameters/SiwaAgentWallet"
          },
          {
            "$ref": "#/components/parameters/SiwaAgentChainId"
          },
          {
            "$ref": "#/components/parameters/HttpSignatureInput"
          },
          {
            "$ref": "#/components/parameters/HttpSignature"
          },
          {
            "$ref": "#/components/parameters/ContentDigest"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "name",
                  "harness"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "harness": {
                    "$ref": "#/components/schemas/AgentHarness"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The agent is paired with the account that issued the code",
            "headers": {
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairedAgentEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/AgentPairingFailed"
          },
          "401": {
            "$ref": "#/components/responses/AgentVerificationFailed"
          },
          "409": {
            "$ref": "#/components/responses/AgentPairConflict"
          },
          "429": {
            "$ref": "#/components/responses/AgentRateLimited"
          },
          "503": {
            "$ref": "#/components/responses/AgentVerificationUnavailable"
          },
          "default": {
            "$ref": "#/components/responses/AgentSignInRefused"
          }
        }
      }
    },
    "/api/agents/v1/me": {
      "get": {
        "operationId": "checkInAgent",
        "summary": "Check in as a paired agent",
        "description": "Records this request as the agent's latest contact, which its person sees on their Account page, and returns the paired agent with the names of the account it is paired with. Sign the request with your SIWA key; it has no body.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/SiwaReceipt"
          },
          {
            "$ref": "#/components/parameters/SiwaKeyId"
          },
          {
            "$ref": "#/components/parameters/SiwaTimestamp"
          },
          {
            "$ref": "#/components/parameters/SiwaAgentWallet"
          },
          {
            "$ref": "#/components/parameters/SiwaAgentChainId"
          },
          {
            "$ref": "#/components/parameters/HttpSignatureInput"
          },
          {
            "$ref": "#/components/parameters/HttpSignature"
          }
        ],
        "responses": {
          "200": {
            "description": "The paired agent, with this check-in recorded as its latest contact",
            "headers": {
              "RateLimit": {
                "$ref": "#/components/headers/RateLimit"
              },
              "RateLimit-Policy": {
                "$ref": "#/components/headers/RateLimitPolicy"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckedInAgentEnvelope"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/AgentVerificationFailed"
          },
          "404": {
            "$ref": "#/components/responses/AgentNotPaired"
          },
          "429": {
            "$ref": "#/components/responses/AgentRateLimited"
          },
          "409": {
            "$ref": "#/components/responses/AgentRequestReplayed"
          },
          "503": {
            "$ref": "#/components/responses/AgentVerificationUnavailable"
          },
          "default": {
            "$ref": "#/components/responses/AgentSignInRefused"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "PrivyAccessToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Privy access token for the requesting account."
      },
      "PrivyIdentityToken": {
        "type": "apiKey",
        "in": "header",
        "name": "Privy-Id-Token",
        "description": "Privy identity JWT, required alongside the access token. Not a Regents API key."
      }
    },
    "schemas": {
      "ClaimsPage": {
        "type": "object",
        "required": [
          "claims",
          "next"
        ],
        "properties": {
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            }
          },
          "next": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque continuation cursor; null means there are no more records."
          }
        }
      },
      "Claim": {
        "type": "object",
        "required": [
          "id",
          "name",
          "ens_name",
          "owner_address",
          "status",
          "transaction",
          "ens_transaction",
          "claimed_at",
          "ens_assigned_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Recorded numeric identifier represented as a string."
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Recorded fully qualified name."
          },
          "ens_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Recorded ENS name, when present."
          },
          "owner_address": {
            "type": [
              "string",
              "null"
            ],
            "description": "Historical wallet ownership evidence, not an entitlement grant."
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "transaction": {
            "type": [
              "string",
              "null"
            ]
          },
          "ens_transaction": {
            "type": [
              "string",
              "null"
            ]
          },
          "claimed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ens_assigned_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ClaimsError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "hint"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "authentication_required",
                  "invalid_claims_query",
                  "invalid_cursor",
                  "claims_forbidden",
                  "claims_unconfigured",
                  "claims_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            }
          }
        }
      },
      "HTTPError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "hint"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            }
          }
        }
      },
      "PairedAgentEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/PairedAgent"
          }
        }
      },
      "PairedAgent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "harness",
          "wallet",
          "paired_at",
          "last_contact_at",
          "registry_listing",
          "human_backed",
          "same_person_agent_count"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "harness": {
            "$ref": "#/components/schemas/AgentHarness"
          },
          "wallet": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "paired_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_contact_at": {
            "type": "string",
            "format": "date-time"
          },
          "registry_listing": {
            "description": "The agent's page in the agent registry, or null when it has no listing there.",
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "human_backed": {
            "description": "Whether a person verified with World ID stands behind the agent. Once true, it stays true, because the first person saved stays linked to the agent for good.",
            "type": "boolean"
          },
          "same_person_agent_count": {
            "description": "How many agents, this one included, the same verified person stands behind, or null when no verified person stands behind the agent.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      },
      "CheckedInAgentEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "$ref": "#/components/schemas/CheckedInAgent"
          }
        }
      },
      "CheckedInAgent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "harness",
          "wallet",
          "paired_at",
          "last_contact_at",
          "registry_listing",
          "human_backed",
          "same_person_agent_count",
          "account"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "harness": {
            "$ref": "#/components/schemas/AgentHarness"
          },
          "wallet": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          },
          "paired_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_contact_at": {
            "type": "string",
            "format": "date-time"
          },
          "registry_listing": {
            "description": "The agent's page in the agent registry, or null when it has no listing there.",
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "human_backed": {
            "description": "Whether a person verified with World ID stands behind the agent. Once true, it stays true, because the first person saved stays linked to the agent for good.",
            "type": "boolean"
          },
          "same_person_agent_count": {
            "description": "How many agents, this one included, the same verified person stands behind, or null when no verified person stands behind the agent.",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "account": {
            "$ref": "#/components/schemas/PairedAccount"
          }
        }
      },
      "PairedAccount": {
        "description": "The names of the account an agent is paired with, as its person sees them on their Account page. Either is null until the person has one.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "display_name",
          "ens_name"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "ens_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "AgentHarness": {
        "type": "string",
        "enum": [
          "hermes",
          "grok_bot",
          "muse",
          "openclaw",
          "nemoclaw",
          "ironclaw",
          "pi",
          "claude_code",
          "codex",
          "cursor",
          "gemini_cli",
          "dots",
          "other"
        ]
      },
      "AgentPairingError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "hint"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "pairing_failed, harness_unknown, agent_limit, not_paired, verification_failed, verification_unavailable or rate_limited, or a code the sign-in service gave, which https://siwa.regents.sh/skill.md explains"
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProductSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "name",
          "summary",
          "site",
          "page",
          "github"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "autolaunch",
              "techtree",
              "patchbay"
            ]
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "format": "uri",
            "description": "The product's own website."
          },
          "page": {
            "type": "string",
            "format": "uri",
            "description": "The product's page on Regents."
          },
          "github": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ProductList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductSummary"
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "description": "Everything the product's page on Regents shows. Techtree and Patchbay carry what_it_does and about; Autolaunch carries launches, why_fair and before_you_bid.",
        "required": [
          "slug",
          "name",
          "domain",
          "site",
          "page",
          "github",
          "kicker",
          "headline",
          "summary",
          "audience",
          "family",
          "agent_line",
          "start"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "enum": [
              "autolaunch",
              "techtree",
              "patchbay"
            ]
          },
          "name": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "site": {
            "type": "string",
            "format": "uri"
          },
          "page": {
            "type": "string",
            "format": "uri"
          },
          "github": {
            "type": "string",
            "format": "uri"
          },
          "kicker": {
            "type": "string"
          },
          "headline": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "what_it_does": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "copy",
                "status",
                "link"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "copy": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "description": "What the product offers today: live is available now, experimental can be tried but may change, planned cannot be used yet.",
                  "enum": [
                    "live",
                    "experimental",
                    "planned"
                  ]
                },
                "link": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "description": "Where to try it. Always null when the status is planned.",
                  "additionalProperties": false,
                  "required": [
                    "label",
                    "href"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "href": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          },
          "about": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "launches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kicker",
                "title",
                "copy",
                "facts"
              ],
              "properties": {
                "kicker": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "copy": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "facts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "value"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "why_fair": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "title",
                "copy"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "copy": {
                  "type": "string"
                }
              }
            }
          },
          "before_you_bid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audience": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "family": {
            "type": "string"
          },
          "agent_line": {
            "type": "string",
            "description": "A line to give an agent."
          },
          "start": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "href"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "href": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      },
      "ProductEnvelope": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product"
        ],
        "properties": {
          "product": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "hint"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "product_not_found",
                  "invalid_query"
                ]
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            }
          }
        }
      },
      "StakingPosition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position"
        ],
        "properties": {
          "position": {
            "type": "object",
            "additionalProperties": false,
            "description": "The contract reading and the wallet reading the Stake page shows, merged. Amounts are exact decimal strings, and each has a _raw companion in base units. block_number belongs to the contract figures and wallet_block_number to the wallet's. A figure that could not be read is the string unavailable.",
            "properties": {
              "chain_id": {},
              "chain_label": {},
              "block_number": {},
              "block_hash": {},
              "read_at": {},
              "contract_address": {},
              "stake_token_address": {},
              "usdc_address": {},
              "paused": {},
              "total_staked_raw": {},
              "total_staked": {},
              "remaining_capacity_raw": {},
              "usdc_received_from_block": {},
              "usdc_received_7d_raw": {},
              "usdc_received_7d": {},
              "usdc_received_lifetime_raw": {},
              "usdc_received_lifetime": {},
              "regent_total_supply_raw": {},
              "regent_total_supply": {},
              "regent_circulating_supply_raw": {},
              "regent_circulating_supply": {},
              "clanker_vault_address": {},
              "clanker_vault_held_raw": {},
              "clanker_vault_held": {},
              "clanker_vault_locked_until": {},
              "clanker_vault_vested_by": {},
              "treasury_address": {},
              "treasury_held_raw": {},
              "treasury_held": {},
              "animata_redeemer_address": {},
              "animata_redeemer_held_raw": {},
              "animata_redeemer_held": {},
              "reward_inventory_raw": {},
              "reward_inventory": {},
              "regent_price_usd": {},
              "emission_apr_bps": {},
              "emission_apr_percent": {},
              "wallet_block_number": {},
              "wallet_block_hash": {},
              "wallet_address": {},
              "wallet_token_balance_raw": {},
              "wallet_token_balance": {},
              "wallet_usdc_balance_raw": {},
              "wallet_usdc_balance": {},
              "wallet_stake_allowance_raw": {},
              "wallet_stake_balance_raw": {},
              "wallet_stake_balance": {},
              "wallet_claimable_usdc_raw": {},
              "wallet_claimable_usdc": {},
              "wallet_claimable_regent_raw": {},
              "wallet_claimable_regent": {},
              "wallet_funded_claimable_regent_raw": {},
              "wallet_funded_claimable_regent": {}
            }
          }
        }
      },
      "StakingError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "hint"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_query",
                  "wallet_required",
                  "authentication_required",
                  "staking_unconfigured",
                  "staking_unavailable"
                ]
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "parameters": {
      "SiwaReceipt": {
        "name": "x-siwa-receipt",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "SiwaKeyId": {
        "name": "x-key-id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "SiwaTimestamp": {
        "name": "x-timestamp",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^\\d+$"
        }
      },
      "SiwaAgentWallet": {
        "name": "x-agent-wallet-address",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      },
      "SiwaAgentChainId": {
        "name": "x-agent-chain-id",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "const": "8453"
        }
      },
      "HttpSignatureInput": {
        "name": "x-siwa-signature-input",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "HttpSignature": {
        "name": "x-siwa-signature",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "ContentDigest": {
        "name": "content-digest",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "headers": {
      "RateLimit": {
        "description": "What is left of the budget this request counted against, as \"policy\";r=remaining;t=seconds until the window resets.",
        "schema": {
          "type": "string"
        }
      },
      "RateLimitPolicy": {
        "description": "The budget this request counted against, as \"policy\";q=requests;w=window seconds. Pairing allows 10 requests and check-ins 60 per client address per minute.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait before the budget resets.",
        "schema": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "responses": {
      "AgentNotPaired": {
        "description": "The signing agent is not paired with an account",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            },
            "examples": {
              "notPaired": {
                "value": {
                  "error": {
                    "code": "not_paired",
                    "message": "This agent is not paired with an account.",
                    "hint": "Ask your person for a pairing code, then pair again."
                  }
                }
              }
            }
          }
        }
      },
      "AgentPairingFailed": {
        "description": "The pairing code could not be claimed, or the runtime is not on the list",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            },
            "examples": {
              "pairingFailed": {
                "value": {
                  "error": {
                    "code": "pairing_failed",
                    "message": "The pairing code could not be used.",
                    "hint": "Ask your person for a new pairing code. Each code works once and expires ten minutes after it was made."
                  }
                }
              },
              "harnessUnknown": {
                "value": {
                  "error": {
                    "code": "harness_unknown",
                    "message": "That harness is not one we know.",
                    "hint": "Send one of: hermes, grok_bot, muse, openclaw, nemoclaw, ironclaw, pi, claude_code, codex, cursor, gemini_cli, dots, other. Send other if yours is not listed."
                  }
                }
              }
            }
          }
        }
      },
      "AgentVerificationFailed": {
        "description": "The sign-in service did not verify the signed agent request. The answer is verification_failed, or the sign-in service's own refusal, whose message and hint say what went wrong and what to do next",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            },
            "examples": {
              "verificationFailed": {
                "value": {
                  "error": {
                    "code": "verification_failed",
                    "message": "The signed agent request could not be verified.",
                    "hint": "Sign the request with your agent key as https://siwa.regents.sh/skill.md describes, then send it again."
                  }
                }
              },
              "headersMissing": {
                "value": {
                  "error": {
                    "code": "http_headers_missing",
                    "hint": "The request's signature headers are missing, too old or malformed. Send it with `uv run siwa_agent.py request METHOD URL`, which signs each request fresh, just before sending. Each signature works once, for two minutes.",
                    "message": "missing required signed agent headers"
                  }
                }
              }
            }
          }
        }
      },
      "AgentRateLimited": {
        "description": "Too many requests were received from the client address",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          },
          "Retry-After": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            },
            "examples": {
              "rateLimited": {
                "value": {
                  "error": {
                    "code": "rate_limited",
                    "message": "Too many requests.",
                    "hint": "Wait the number of seconds in Retry-After, then try again."
                  }
                }
              }
            }
          }
        }
      },
      "AgentRequestReplayed": {
        "content": {
          "application/json": {
            "examples": {
              "requestReplayed": {
                "value": {
                  "error": {
                    "code": "request_replayed",
                    "hint": "That signed request was already used; each one works once. Run `request` again to sign it fresh, and never resend saved signature headers.",
                    "message": "request replay detected"
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            }
          }
        },
        "description": "The sign-in service has already verified this exact signed request once",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          }
        }
      },
      "AgentVerificationUnavailable": {
        "content": {
          "application/json": {
            "examples": {
              "verificationUnavailable": {
                "value": {
                  "error": {
                    "code": "verification_unavailable",
                    "hint": "Try again in a minute.",
                    "message": "The sign-in service could not be reached."
                  }
                }
              }
            },
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            }
          }
        },
        "description": "The sign-in service could not be reached to verify the request",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          }
        }
      },
      "AgentSignInRefused": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            }
          }
        },
        "description": "Another refusal from the sign-in service, passed on unchanged: its status, code, message, and a hint written for this site and the agent's signing tool",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          }
        }
      },
      "AgentPairConflict": {
        "description": "The sign-in service has already verified this exact signed request once, or the person's account already has 100 paired agents",
        "headers": {
          "RateLimit": {
            "$ref": "#/components/headers/RateLimit"
          },
          "RateLimit-Policy": {
            "$ref": "#/components/headers/RateLimitPolicy"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AgentPairingError"
            },
            "examples": {
              "requestReplayed": {
                "value": {
                  "error": {
                    "code": "request_replayed",
                    "message": "request replay detected",
                    "hint": "That signed request was already used; each one works once. Run `request` again to sign it fresh, and never resend saved signature headers."
                  }
                }
              },
              "agentLimit": {
                "value": {
                  "error": {
                    "code": "agent_limit",
                    "message": "This account already has 100 paired agents.",
                    "hint": "Ask your person to unpair an agent on their Regents account page, then pair again. The same code works until it expires."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
