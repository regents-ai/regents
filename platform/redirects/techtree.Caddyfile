{
	auto_https off
	admin off
}

(perm_redir) {
	redir @non_get {args[0]} 308
	redir {args[0]} 301
}

:8080 {
	@non_get {
		not method GET HEAD
	}
	@has_query expression `{query} != ""`

	@shared_discovery path /openapi.json /.well-known/oauth-protected-resource /.well-known/api-catalog /.well-known/ai-catalog.json /mcp/server-card /server.json
	handle @shared_discovery {
		import perm_redir "https://regents.sh{uri}"
	}

	handle /capabilities.json {
		import perm_redir "https://regents.sh/api/v1/techtree/capabilities"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle / {
		handle @has_query {
			import perm_redir "https://regents.sh/techtree?{query}"
		}
		handle {
			import perm_redir "https://regents.sh/techtree"
		}
	}

	@techtree_projects path /account/projects /account/projects/*
	handle @techtree_projects {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh/techtree{uri}"
		}
	}

	@techtree_api_projects path /api/v1/account/projects /api/v1/account/projects/*
	handle @techtree_api_projects {
		route {
			uri strip_prefix /api/v1
			uri strip_suffix /
			import perm_redir "https://regents.sh/api/v1/techtree{uri}"
		}
	}

	@shared_root path /account /account/* /pair /api/agents/v1/* /api/v1/health /api/v1/account /api/v1/account/* /api/v1/profile /api/v1/profile/* /api/v1/messages/*
	handle @shared_root {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh{uri}"
		}
	}

	@points path /points /points/*
	handle @points {
		import perm_redir "https://regents.sh/account/points"
	}

	handle_path /api/model-climb/v1/* {
		header Link "<https://regents.sh/api/v1/techtree/model-climb/reports>; rel=successor-version"
		respond "Use https://regents.sh/api/v1/techtree/model-climb/reports and sign the new address." 410
	}

	handle_path /api/v1/* {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh/api/v1/techtree{uri}"
		}
	}

	handle {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh/techtree{uri}"
		}
	}
}
