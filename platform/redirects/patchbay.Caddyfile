{
	auto_https off
	admin off
}

(perm_redir) {
	redir @non_get {args[0]} 308
	redir {args[0]} 301
}

:8080 {
	@non_get {
		not method GET HEAD
	}
	@has_query expression `{query} != ""`

	@shared_discovery path /openapi.json /api-contract.openapiv3.yaml /robots.txt /sitemap.xml /.well-known/security.txt /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/mcp /.well-known/oauth-authorization-server /.well-known/api-catalog /.well-known/ai-catalog.json /.well-known/mcp/server-card.json /mcp/server-card /server.json
	handle @shared_discovery {
		import perm_redir "https://regents.sh{uri}"
	}

	@mcp_path path /mcp /mcp/ /chatgpt/mcp /chatgpt/mcp/
	handle @mcp_path {
		route {
			uri strip_prefix /chatgpt
			uri strip_suffix /
			import perm_redir "https://regents.sh{uri}"
		}
	}

	@scoped path /patchbay /patchbay/* /api/v1/patchbay /api/v1/patchbay/* /api/agent/v1/patchbay /api/agent/v1/patchbay/*
	handle @scoped {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh{uri}"
		}
	}

	handle /.well-known/oauth-protected-resource/chatgpt/mcp {
		import perm_redir "https://regents.sh/.well-known/oauth-protected-resource/mcp"
	}

	handle /capabilities.json {
		import perm_redir "https://regents.sh/api/v1/patchbay/capabilities"
	}

	handle /healthz {
		respond "ok" 200
	}

	handle / {
		handle @has_query {
			import perm_redir "https://regents.sh/patchbay/app?{query}"
		}
		handle {
			import perm_redir "https://regents.sh/patchbay/app"
		}
	}

	handle /skill.md {
		import perm_redir "https://regents.sh/patchbay/skill.md"
	}

	@shared_root path /account /account/* /pair /api/agents/v1/* /api/v1/health /api/v1/account /api/v1/account/* /api/v1/profile /api/v1/profile/* /api/v1/messages/* /api/agent/v1/account /api/agent/v1/account/* /api/agent/v1/claims /api/agent/v1/staking/position
	handle @shared_root {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh{uri}"
		}
	}

	@points path /points /points/*
	handle @points {
		import perm_redir "https://regents.sh/account/points"
	}

	handle_path /api/v1/* {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh/api/v1/patchbay{uri}"
		}
	}

	handle_path /api/agent/v1/* {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh/api/agent/v1/patchbay{uri}"
		}
	}

	handle {
		route {
			uri strip_suffix /
			import perm_redir "https://regents.sh/patchbay{uri}"
		}
	}
}
