#!/bin/sh
set -eu

# The tagging runs inside the running site, which has its own environment and its
# own folder, so the path travels inside the call as a whole absolute path.
case "$#" in
  1) path="$(printf %s "$(realpath "$1")" | base64 | tr -d '\n')" ;;
  *) echo 'usage: tag-papers <tags.yaml>' >&2; exit 1 ;;
esac

exec "$(dirname "$0")/regents" rpc "Regents.Release.tag_papers(Base.decode64!(\"$path\"))"
