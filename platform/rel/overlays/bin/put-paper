#!/bin/sh
set -eu

case "$#" in
  1)
    REGENTS_RELEASE_COMMAND=migrate REGENTS_PAPER="$1" exec "$(dirname "$0")/regents" eval 'Regents.Release.put_paper(System.fetch_env!("REGENTS_PAPER"))'
    ;;
  2)
    REGENTS_RELEASE_COMMAND=migrate REGENTS_PAPER="$1" REGENTS_PAPER_PICTURE="$2" exec "$(dirname "$0")/regents" eval 'Regents.Release.put_paper(System.fetch_env!("REGENTS_PAPER"), System.fetch_env!("REGENTS_PAPER_PICTURE"))'
    ;;
  *)
    echo 'usage: put-paper <folder> OR put-paper <YYYY-MM-DD>.md <picture>' >&2
    exit 1
    ;;
esac
