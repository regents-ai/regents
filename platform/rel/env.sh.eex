#!/bin/sh

# Configure distributed Erlang over Fly's 6PN private IPv6 network when running
# on Fly.io so multiple web machines form a cluster automatically for PubSub,
# ProductActivity, SharedReading, and cross-instance SSE feed handoff.
if [ -n "$FLY_APP_NAME" ] && [ -n "$FLY_PRIVATE_IP" ]; then
  export ERL_AFLAGS="-proto_dist inet6_tcp"
  export RELEASE_DISTRIBUTION=name
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
fi
