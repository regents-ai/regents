<!DOCTYPE html> <% home? = @conn.request_path == "/" %>
<% theme = if home?, do: "dark", else: @theme %>
<html
  lang="en"
  data-brand="platform"
  data-theme={theme}
  data-home-theme-locked={if home?, do: "true", else: "false"}
>
  <head>
    <meta charset="utf-8" />
    <link rel="alternate" type="text/plain" title="Agent guide" href={~p"/llms.txt"} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={theme} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="privy-app-id" content={Application.get_env(:ash_platform, :privy, [])[:app_id]} />
    <meta
      name="privy-bridge-src"
      content={AshPlatformWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <.live_title default="Regent" suffix=" · Regents Labs">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={~p"/favicon.ico"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png?v=2"} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={~p"/favicon.svg?v=2"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <meta name="theme-color" content={if theme == "dark", do: "#161616", else: "#e5e3d2"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
    <.product_links :if={!home?} theme={theme} />
  </body>
</html>
