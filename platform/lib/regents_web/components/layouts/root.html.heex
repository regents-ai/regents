<!DOCTYPE html> <% home? = @conn.request_path == "/" %>
<% metadata =
  RegentsWeb.PublicDocuments.metadata(@conn.request_path, @page_title, @page_description) %>
<%!-- A page may name its own share picture (`share_image`: its url, size and alt, as a
     published Result does); every other page shows the site's for its address. --%>
<% share_image = assigns[:share_image] || metadata.share_image %>
<%!-- A product's page may also name its own canonical address (`canonical`, a whole url,
     as an older changelog page does) and its own schema.org graph (`structured_data`);
     every other page has its address and the site's graph. --%>
<% canonical = assigns[:canonical] || metadata.canonical %>
<% structured_data = assigns[:structured_data] || RegentsWeb.PublicDocuments.structured_data() %>
<%!-- A product's page that also answers as Markdown says so (`markdown?`), as the
     site's own documents do by their address. --%>
<% markdown? = assigns[:markdown?] || metadata.markdown? %>
<%!-- The app shell fills the window and scrolls inside itself, so its pages carry these links in that scroll. --%>
<% shell? =
  assigns[:live_module] in [RegentsWeb.ShellLive, RegentsWeb.ShowcaseLive] %>
<%!-- The page's product (`Regent.Site`), from the router or the shell page: its look,
     its brand's ground, and the home colour. A link to another product loads the page,
     as these are written only here. --%>
<% marketing_page = assigns[:marketing_page] %>
<html
  lang="en"
  data-marketing={marketing_page && ""}
  data-page={marketing_page}
  data-hero-mode={if(marketing_page == "home", do: hero_mode(@conn))}
  data-product={@site_product}
  data-brand={Regent.Site.brand(@site_product)}
  data-home={home_colour(@conn)}
  data-theme={@theme}
>
  <head>
    <meta charset="utf-8" />
    <Regent.AgentMetadata.head
      title={metadata.title}
      description={metadata.description}
      canonical={canonical}
      site_name="Regents Labs"
      site_type={RegentsWeb.PublicDocuments.site_type(@conn.request_path)}
      image={share_image.url}
      image_width={elem(share_image.size, 0)}
      image_height={elem(share_image.size, 1)}
      image_alt={share_image.alt}
      twitter_site="@regents_sh"
      markdown={markdown?}
      agent_guide={~p"/llms.txt"}
      sitemap={~p"/sitemap.xml"}
      service_description={~p"/openapi.json"}
      structured_data={structured_data}
    />
    <meta name="application-name" content="Regents Labs" />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="Regents Labs, AI agents, agent platform, REGENT staking, Autolaunch, Keyfleet, Patchbay, Techtree, Cloak, SIWA, MCP, WebMCP"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={@theme || "dark light"} />
    <meta name="agent-request-origin" content={RegentsWeb.Endpoint.url()} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta :if={assigns[:session_refused]} name="session-refused" content="true" />
    <%!-- Where the site only reads, Sign in says sign-in opens later (app.ts). --%>
    <meta :if={Regents.read_only?()} name="sign-in" content="later" />
    <meta name="privy-app-id" content={Application.get_env(:regents, :privy, [])[:app_id]} />
    <meta name="wallet-chain-id" content={Regents.Chain.Client.base().chain_id} />
    <meta :if={assigns[:visit]} name="regent-visit" content={assigns[:visit]} />
    <meta
      name="privy-bridge-src"
      content={RegentsWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <.live_title suffix={metadata.suffix}>{@page_title}</.live_title>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={~p"/favicon.ico"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png?v=2"} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={~p"/favicon.svg?v=2"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <% {theme_dark, theme_light} =
      case @site_product do
        "techtree" -> {"#0d1611", "#f3f5ef"}
        "patchbay" -> {"#111726", "#f6f7fa"}
        _other -> {"#161616", "#e5e3d2"}
      end %>
    <meta
      :if={@theme}
      name="theme-color"
      content={if @theme == "dark", do: theme_dark, else: theme_light}
    />
    <meta
      :if={!@theme}
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content={theme_light}
    />
    <meta
      :if={!@theme}
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content={theme_dark}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {if assigns[:harbour_sea], do: RegentsWeb.Keyfleet.HarbourSeaLive.sea(@conn)}
    <RegentsWeb.Components.Shell.site_bar
      :if={@conn.request_path in ["/admin/messages", "/admin/pictures"]}
      product="regents"
      current_path={@conn.request_path}
    />
    {@inner_content}
    {RegentsWeb.SearchLive.dialog(@conn)}
    <Regent.Structure.confirm />
    <.product_links :if={
      !home? and !marketing_page and !shell? and
        @site_product not in ~w(techtree keyfleet autolaunch patchbay)
    } />
  </body>
</html>
