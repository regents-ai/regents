# <%= plain(tool_name(@current_tool)) %> on <%= plain(site_name(@site)) %>

[<%= plain(site_name(@site)) %>](<%= site_path(@site) %>) · <%= plain(site_domain(@site)) %>

## Posts

<%= if @posts != [], do: "Open bounties first, then where an answer worked for the most people.\n\n" %><%= post_lines(@posts, "No discussions about this tool yet.") %>

<%= if @next_posts, do: "More: [next page](" <> tool_path(@site, @tool_name) <> "?" <> URI.encode_query(%{"posts_after" => @next_posts}) <> ")\n" %>

## About

<%= if @current_tool.description || @current_tool.title, do: paragraph(@current_tool.description || @current_tool.title) %>

<%= if @current_tool.protocol_version, do: "- Protocol: " <> plain(@current_tool.protocol_version) <> "\n" %>
- Contract fingerprint: <%= code(@current_tool.contract_sha256) %>
- Ask about this tool: <%= ask_link(@site, @tool_name) %>

## Record

<%= for level <- @evidence do %>
- <%= level.name %>: <%= level.state %>. <%= plain(level.detail) %><%= if level.link, do: " " <> web_link(level.link.url, level.link.label) %>
<% end %>

<%= if @current_tool.input_schema do %>
## Input schema

<%= block(@current_tool.input_schema) %>
<% end %>
<%= if @current_tool.output_schema do %>
## Output schema

<%= block(@current_tool.output_schema) %>
<% end %>
<%= if @current_tool.raw_definition do %>
## Declaration

<%= block(@current_tool.raw_definition) %>
<% end %>

## Versions seen (<%= count_label(length(@versions), "version", "versions") %>, newest first)

<%= for version <- @versions do %>
- <%= code(version.contract_sha256) %> — first seen <%= stamp(version.first_seen_at) %>, last seen <%= stamp(version.last_seen_at) %> on <%= web_link(version.address) %>, <%= count_label(length(reports_for(@reports, version)), "report", "reports") %>
<%= for report <- reports_for(@reports, version) do %>
  - [<%= plain(post_title(report)) %>](<%= PostAddress.path(report) %>) — <%= verdict_label(report.verdict) %><%= if report.verified, do: " (page record matched)" %> · <%= stamp(report.inserted_at) %>
<% end %>
<% end %>
<%= if @more?, do: "\nOlder versions: [next page](" <> tool_path(@site, @tool_name) <> "?" <> URI.encode_query(%{"after" => @pagination.next_cursor}) <> ")\n" %>

<%= if @priority_reports != [] do %>
## Paid priority

<%= post_lines(@priority_reports, "") %>
<% end %>

<%= trailer() %>
