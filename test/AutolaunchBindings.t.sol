pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import {
    IRegentRevenueStakingFunding
} from "src/autolaunch/interfaces/IRegentRevenueStakingFunding.sol";
import {AutolaunchBindings} from "src/autolaunch/libraries/AutolaunchBindings.sol";

contract AutolaunchBindingsHarness {
    function canonical() external pure returns (AutolaunchBindings.Bindings memory) {
        return AutolaunchBindings.canonical();
    }

    function validate(AutolaunchBindings.Bindings calldata bindings) external view {
        AutolaunchBindings.validate(bindings);
    }

    function canonicalRuntimeIdentities()
        external
        pure
        returns (bytes32 stakingCodeHash, bytes32 ccaCodeHash, uint256 ccaRuntimeSize)
    {
        return (
            AutolaunchBindings.REGENT_REVENUE_STAKING_RUNTIME_CODE_HASH,
            AutolaunchBindings.CCA_FACTORY_RUNTIME_CODE_HASH,
            AutolaunchBindings.CCA_FACTORY_RUNTIME_SIZE
        );
    }
}

contract AutolaunchBindingsTest is Test {
    AutolaunchBindingsHarness internal harness;
    AutolaunchBindings.Bindings internal bindings;

    function setUp() external {
        vm.chainId(8453);
        harness = new AutolaunchBindingsHarness();
        bindings = harness.canonical();
        vm.etch(bindings.staking, _stakingRuntime());
        vm.etch(bindings.ccaFactory, _ccaFactoryRuntime());
    }

    function testCanonicalBindingsAndFundingSelectorAreFrozen() external view {
        assertEq(bindings.regent, 0x6f89bcA4eA5931EdFCB09786267b251DeE752b07);
        assertEq(bindings.staking, 0xb027Dc261636E30Cbc0fE25b2F8e1ed273354AB5);
        assertEq(bindings.ccaFactory, 0x000000001F26a0044BaA66024e7b6599c61963F8);
        assertEq(bindings.quoteToken, 0x6f89bcA4eA5931EdFCB09786267b251DeE752b07);
        assertEq(bindings.quoteToken, bindings.regent);
        assertEq(bindings.poolManager, 0x498581fF718922c3f8e6A244956aF099B2652b2b);
        assertEq(bindings.positionManager, 0x7C5f5A4bBd8fD63184577525326123B519429bDc);
        assertEq(
            bytes32(IRegentRevenueStakingFunding.fundRegentRewards.selector),
            bytes32(bytes4(0x5a741e20))
        );
        (bytes32 stakingCodeHash, bytes32 ccaCodeHash, uint256 ccaRuntimeSize) =
            harness.canonicalRuntimeIdentities();
        assertEq(
            stakingCodeHash, 0xcaef93094fa27d35f5ff9e619d5ee75528c7c18f19f4f31a0a5eaba62a976497
        );
        assertEq(ccaCodeHash, 0xa1d2a90564f4f63580b25de42efaff92505c254b00fc666f65ab38126cce5cfa);
        assertEq(ccaRuntimeSize, 24_214);
    }

    function testValidatesAllBindingsAndRuntimeIdentities() external view {
        harness.validate(bindings);
    }

    function testRejectsEveryAddressBindingMismatch() external {
        for (uint256 i; i < 6; ++i) {
            AutolaunchBindings.Bindings memory changed = bindings;
            if (i == 0) changed.regent = address(0xBAD1);
            if (i == 1) changed.staking = address(0xBAD2);
            if (i == 2) changed.ccaFactory = address(0xBAD3);
            if (i == 3) changed.quoteToken = address(0xBAD4);
            if (i == 4) changed.poolManager = address(0xBAD5);
            if (i == 5) changed.positionManager = address(0xBAD6);
            vm.expectRevert();
            harness.validate(changed);
        }
    }

    function testRejectsStakingRuntimeMismatch() external {
        vm.etch(bindings.staking, hex"00");
        vm.expectRevert();
        harness.validate(bindings);
    }

    function testRejectsCcaRuntimeMismatch() external {
        vm.etch(bindings.ccaFactory, hex"00");
        vm.expectRevert();
        harness.validate(bindings);
    }

    function testRejectsWrongChain() external {
        vm.chainId(1);
        vm.expectRevert();
        harness.validate(bindings);
    }

    function _stakingRuntime() private pure returns (bytes memory) {
        return hex"";
    }

    function _ccaFactoryRuntime() private pure returns (bytes memory) {
        return hex"";
    }
}
