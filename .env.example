# Copy this file to .env, keep machine-specific overrides in .env.local,
# and load both from your ignored .envrc with direnv.
#
# Suggested ignored .envrc contents:
#   source_env .env
#   source_env_if_exists .env.local
#
# After direnv loads the values, prepare the guarded local database with:
#   mix ash_platform.setup_local_auth
#
# Never commit .env, .env.local, or .envrc.

# Privy browser sign-in.
export PRIVY_APP_ID=''

# PEM-encoded ES256 verification PUBLIC key, not the Privy app secret.
# A native multiline PEM or a one-line value with literal \n escapes is accepted.
# Example shape:
# export PRIVY_VERIFICATION_KEY='-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----'
export PRIVY_VERIFICATION_KEY=''

# Server-only Sprites API token used to provision and inspect Formation runtimes.
export SPRITES_TOKEN=''

# Optional comma-separated wallets that may remove comments from any public record.
export REGENT_ADMIN_WALLET_ADDRESSES=''

# Autolaunch pages and endpoints stay closed by default. Only 'on' opens them.
# Left commented here on purpose; uncomment to open them on a local server.
# export ASH_PLATFORM_AUTOLAUNCH_SURFACES='on'

# Base mainnet JSON-RPC endpoint the Stake and Redeem pages read from.
# Required in production; development falls back to a public endpoint.
# Example shape: https://mainnet.base.org
export BASE_READ_RPC_URL=''

# Fly Managed Postgres variable names. Supply values through the approved secret source.
# DATABASE_POOLED_URL
# DATABASE_DIRECT_URL
# ASH_PLATFORM_DATABASE_TARGET_MODE
# ASH_PLATFORM_DATABASE_CLUSTER_ID
# ASH_PLATFORM_DATABASE_CLUSTER_NAME
