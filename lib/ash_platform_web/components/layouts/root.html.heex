<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="privy-app-id" content={Application.get_env(:ash_platform, :privy, [])[:app_id]} />
    <meta
      name="privy-bridge-src"
      content={AshPlatformWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <.live_title default="Regent" suffix=" · Regents Labs">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const root = document.documentElement;
        const pathname = window.location.pathname;
        const isPath = (prefix) => pathname === prefix || pathname.startsWith(`${prefix}/`);

        if (pathname === "/") {
          root.removeAttribute("data-brand");
          root.dataset.theme = "light";
          root.removeAttribute("data-theme-choice");
          return;
        }

        root.dataset.brand = isPath("/techtree")
          ? "techtree"
          : isPath("/autolaunch")
            ? "autolaunch"
            : "platform";

        const storedTheme = localStorage.getItem("regent:theme");
        const choice = ["system", "light", "dark"].includes(storedTheme)
          ? storedTheme
          : "system";
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        root.dataset.theme = choice === "dark" || (choice === "system" && prefersDark)
          ? "dark"
          : "light";
        root.dataset.themeChoice = choice;
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
