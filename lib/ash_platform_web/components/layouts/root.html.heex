<!DOCTYPE html>
<%!-- The marketing page is painted dark whatever the visitor saved, so it says so
and reads the same for everyone. --%>
<% theme = if @conn.request_path == "/", do: "dark", else: @theme %>
<html
  lang="en"
  data-brand="platform"
  data-theme={theme}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={theme} />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="privy-app-id" content={Application.get_env(:ash_platform, :privy, [])[:app_id]} />
    <meta
      name="privy-bridge-src"
      content={AshPlatformWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <.live_title default="Regent" suffix=" · Regents Labs">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <meta name="theme-color" content="#e5e3d2" />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <Regent.SiteBackground.site_background :if={
      @conn.request_path != "/" and not String.starts_with?(@conn.request_path, "/showcase")
    } />
    {@inner_content}
  </body>
</html>
