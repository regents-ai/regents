<!DOCTYPE html>
<html
  lang="en"
  data-brand={
    case Path.split(@conn.request_path) do
      ["/"] -> nil
      ["/", "techtree" | _] -> "techtree"
      ["/", "autolaunch" | _] -> "autolaunch"
      _ -> "platform"
    end
  }
  data-theme="light"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="privy-app-id" content={Application.get_env(:ash_platform, :privy, [])[:app_id]} />
    <meta
      name="privy-bridge-src"
      content={AshPlatformWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <.live_title default="Regent" suffix=" · Regents Labs">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="module" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        if (window.location.pathname === "/") return;

        // Blocked storage throws on read; the server-rendered light default already stands.
        let storedTheme = null;
        try {
          storedTheme = localStorage.getItem("regent:theme");
        } catch {}

        const root = document.documentElement;
        const choice = ["system", "light", "dark"].includes(storedTheme)
          ? storedTheme
          : "system";
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;

        root.dataset.theme = choice === "dark" || (choice === "system" && prefersDark)
          ? "dark"
          : "light";
        root.dataset.themeChoice = choice;
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
